#!/bin/bash
# kimi_cli_web - Kimi CLI web search wrapper
# Usage: kimi_cli_web "your query"

# Load environment from project root
cd "$(dirname "$0")/../.." && source .env && cd - > /dev/null

QUERY="$1"
TIMEOUT="${2:-${WEB_SEARCH_TIMEOUT_SECONDS:-90}}"

if [ -z "$QUERY" ]; then
  echo '{"error": "No query provided"}'
  exit 1
fi

KIMI_MODEL="${KIMI_MODEL:-kimi-base}"
kimi --final-message-only -c "$QUERY [ANSWER in Russian]" \
  -y --output-format stream-json --print 2>&1
