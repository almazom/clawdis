#!/bin/bash
# ask_minimax - General purpose MiniMax Claude query wrapper
# Usage: ask_minimax "your question"

# Load environment from project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "$SCRIPT_DIR/../../.env"

QUERY="$1"
TIMEOUT="${2:-120}"

if [ -z "$QUERY" ]; then
  echo '{"error": "No query provided"}'
  exit 1
fi

export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_MINIMAX_MODEL:-MiniMax-M2.1}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_MINIMAX_MODEL:-MiniMax-M2.1}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_MINIMAX_MODEL:-MiniMax-M2.1}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_MINIMAX_MODEL:-MiniMax-M2.1}"
export ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
export ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_MINIMAX_API_KEY:-}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

if [ -z "$ANTHROPIC_AUTH_TOKEN" ]; then
  echo '{"error": "ANTHROPIC_MINIMAX_API_KEY not set"}'
  exit 1
fi

claude -p "$QUERY" \
  --dangerously-skip-permissions --output-format json 2>&1
